# Nexora AI configuration template.
# .env.example is a template only: it is safe to commit and contains no secrets.
# Copy it to .env and put your real values there:  cp .env.example .env
# NEVER commit .env to GitHub (it is listed in .gitignore).

# Application
APP_ENV=development
LOG_LEVEL=INFO

# Security & Authentication
# Enforce API key authentication across all private API endpoints.
# Defaults to true in AppSettings.from_env(). Set to false only for local offline development.
NEXORA_ENFORCE_AUTH=true

# Relational Database (SQLAlchemy PostgreSQL)
# DatabaseConfig enforces PostgreSQL; SQLite is used in offline test fixtures.
# NEXORA_DATABASE_URL takes precedence over DATABASE_URL when set.
# Example PostgreSQL: postgresql+psycopg://nexora:secret@localhost:5432/nexora_db
# NEXORA_DATABASE_URL=postgresql+psycopg://nexora:secret@localhost:5432/nexora_db
# DATABASE_URL=postgresql+psycopg://nexora:secret@localhost:5432/nexora_db

# Database Connection Pool (PostgreSQL / multi-connection pools)
# Recommended pool_size: 10-20 per ASGI worker; max_overflow accommodates traffic bursts.
# NEXORA_DATABASE_POOL_SIZE=5
# NEXORA_DATABASE_MAX_OVERFLOW=10
# NEXORA_DATABASE_POOL_TIMEOUT=30.0
# NEXORA_DATABASE_POOL_RECYCLE=1800
# NEXORA_DATABASE_ECHO=false

# Health & Operational Readiness Probes
# Liveness probe:  GET /health       (touches no dependencies, returns 200 if process alive)
# Readiness probe: GET /ready        (actively checks DB, auth, research, and vector store)
# Readiness alias: GET /health/ready


# LLM Provider Configuration (Supported provider: OpenAI)
# Primary API key for live LLM answer generation:
# NEXORA_LLM_API_KEY=
# Fallback standard OpenAI API key:
# OPENAI_API_KEY=
# LLM_API_KEY=

# LLM model for answer generation (default: gpt-4o-mini)
# NEXORA_LLM_MODEL=gpt-4o-mini
# OPENAI_MODEL=gpt-4o-mini

# Optional custom base URL for OpenAI-compatible proxies, Azure, Ollama, or vLLM:
# NEXORA_LLM_BASE_URL=
# OPENAI_BASE_URL=

# Generator mode: 'live' (requires API key) or 'offline' (deterministic mock, default when no key)
# NEXORA_RAG_GENERATOR_MODE=

# Vector Database (memory | qdrant)
NEXORA_VECTOR_STORE=memory
# NEXORA_QDRANT_HOST=localhost
# NEXORA_QDRANT_PORT=6333
# NEXORA_QDRANT_API_KEY=
# NEXORA_QDRANT_COLLECTION=nexora_chunks
# NEXORA_QDRANT_HTTPS=false

# Embedding provider credentials (Gemini semantic embeddings)
# GEMINI_API_KEY=
# NEXORA_GEMINI_API_KEY=
# NEXORA_EMBEDDING_API_KEY=
# NEXORA_EMBEDDING_PROVIDER=gemini
# NEXORA_EMBEDDING_MODEL=gemini-embedding-2

# Retrieval Quality Policy
# NEXORA_RETRIEVAL_MIN_SCORE=0.3
# NEXORA_RETRIEVAL_MAX_RESULTS=5
# NEXORA_RETRIEVAL_MAX_RESULTS_PER_DOCUMENT=2
# NEXORA_RETRIEVAL_CANDIDATE_LIMIT=20
# NEXORA_MAX_EVIDENCE_CHARACTERS=

# Inbound Rate Limiting & Abuse Protection
# When enabled, sliding-window rate limiting is enforced per caller key/IP.
NEXORA_RATE_LIMIT_ENABLED=false
NEXORA_RATE_LIMIT_WINDOW_SECONDS=60
NEXORA_RATE_LIMIT_HEAVY_ANALYSIS=10
NEXORA_RATE_LIMIT_RESEARCH_QUERY=30
NEXORA_RATE_LIMIT_DISCOVERY_SEARCH=20
NEXORA_RATE_LIMIT_DISCOVERY_IMPORT=10
NEXORA_RATE_LIMIT_DOCUMENT_INGEST=10
NEXORA_RATE_LIMIT_DEFAULT=120
# Rate limiting backend: 'memory' (in-process) or 'redis' (requires providing RateLimitStorage)
NEXORA_RATE_LIMIT_BACKEND=memory
# Comma-separated list of reverse proxy IPs to trust for X-Forwarded-For resolution:
# NEXORA_RATE_LIMIT_TRUSTED_PROXIES=

# Cross-Origin Resource Sharing (CORS)
# Disabled by default. When enabled, origins cannot use wildcard '*' if credentials are permitted.
NEXORA_CORS_ENABLED=false
# Comma-separated list of permitted origins:
# NEXORA_CORS_ALLOWED_ORIGINS=http://localhost:3000,https://app.nexora.ai
NEXORA_CORS_ALLOW_CREDENTIALS=false
# NEXORA_CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS,HEAD
# NEXORA_CORS_ALLOW_HEADERS=Authorization,Content-Type,Accept,X-API-Key
# NEXORA_CORS_MAX_AGE=600
