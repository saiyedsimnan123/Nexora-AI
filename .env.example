# Nexora AI configuration template.
# .env.example is a template only: it is safe to commit and contains no secrets.
# Copy it to .env and put your real values there:  cp .env.example .env
# NEVER commit .env to GitHub (it is listed in .gitignore).

# Application
APP_ENV=development
LOG_LEVEL=INFO

# LLM provider API key (leave empty here; set the real key in .env)
LLM_API_KEY=

# Vector database connection (leave empty until one is chosen)
VECTOR_DB_URL=

# Relational database connection (leave empty until one is chosen)
DATABASE_URL=

# Embedding provider credentials (Milestone 12C-38: Gemini semantic embeddings)
# GEMINI_API_KEY=
# NEXORA_GEMINI_API_KEY=
# NEXORA_EMBEDDING_API_KEY=
# NEXORA_EMBEDDING_PROVIDER=gemini
# NEXORA_EMBEDDING_MODEL=gemini-embedding-2
