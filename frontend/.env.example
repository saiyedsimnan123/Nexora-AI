# Nexora AI Frontend Environment Configuration
# When using Vite dev server proxy (recommended for local development), leave empty.
# In that mode, requests to /api and /health are proxied to http://127.0.0.1:8000.
# If connecting directly to an external API origin, specify the full URL (e.g. http://127.0.0.1:8000).
VITE_API_BASE_URL=
